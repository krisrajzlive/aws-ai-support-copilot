# Copy to .env (git-ignored). Credentials are NOT set here: they come from the
# named AWS CLI profile (run `aws configure --profile sandbox` in your terminal).
COPILOT_AWS_PROFILE=sandbox
COPILOT_AWS_REGION=us-east-1

# Comma-separated Bedrock model IDs, tried in order; first one that responds is used.
COPILOT_BEDROCK_MODELS=amazon.nova-lite-v1:0,amazon.nova-micro-v1:0,amazon.nova-pro-v1:0,qwen.qwen3-32b-v1:0,openai.gpt-oss-120b-1:0

# Routing: a cheap model triages each request, then a persona (prompt + models) writes the reply.
# triage models are tried in order; personas come from src/copilot/default_personas.toml unless
# COPILOT_PERSONAS_FILE points at your own copy.
COPILOT_TRIAGE_MODELS=amazon.nova-micro-v1:0,amazon.nova-lite-v1:0
COPILOT_PERSONAS_FILE=

# Per-service backends. Defaults suit a restricted lab account; switch on AWS-native ones elsewhere.
# translate: bedrock | aws | auto (Amazon Translate, then Bedrock if denied)
COPILOT_TRANSLATE_BACKEND=bedrock
# transcribe: bedrock (Voxtral) | aws (Amazon Transcribe, needs a bucket)
COPILOT_TRANSCRIBE_BACKEND=bedrock
COPILOT_TRANSCRIBE_BUCKET=
# tts: off | polly
COPILOT_TTS_BACKEND=off
COPILOT_POLLY_VOICE=Joanna

# Optional: Bedrock Guardrail created by scripts/create_guardrail.py
COPILOT_GUARDRAIL_ID=
COPILOT_GUARDRAIL_VERSION=DRAFT

# Optional: Lex intake bot from scripts/create_lex_bot.py (used by `copilot intake`)
COPILOT_LEX_BOT_ID=
COPILOT_LEX_BOT_ALIAS_ID=TSTALIASID
COPILOT_LEX_LOCALE=en_US
