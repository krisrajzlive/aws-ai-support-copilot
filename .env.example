# Copy to .env (git-ignored). Credentials are NOT set here: they come from the
# named AWS CLI profile (run `aws configure --profile sandbox` in your terminal).
COPILOT_AWS_PROFILE=sandbox
COPILOT_AWS_REGION=us-east-1

# Comma-separated Bedrock model IDs, tried in order; first one that responds is used.
COPILOT_BEDROCK_MODELS=amazon.nova-lite-v1:0,amazon.nova-micro-v1:0,amazon.nova-pro-v1:0,qwen.qwen3-32b-v1:0,openai.gpt-oss-120b-1:0
